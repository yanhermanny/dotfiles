{{- if .system.is_windows -}}
chezmoi:template:missing-key=invalid

# ---- Importando utils libraries --------------------------------------------
if (-not (Get-Module -Name Logger)) {
    Import-Module "{{ joinPath .chezmoi.workingTree "scripts/windows/utils/Logger.psm1" }}"
}

# ==============================================================================
# Inicialização
# ==============================================================================
Log "[chezmoi] Sistema operacional detectado: Windows" -Level Info
Log "[chezmoi] Iniciando instalação declarativa..." -Level Task


# ==============================================================================
# Helpers
# ==============================================================================

# ---- winget ------------------------------------------------------------------
function Test-WingetInstalled {
  param([string]$Id)

  $pkg = winget list --exact --id $Id --source winget 2>$null
  if ($pkg -match $Id) {
    Log "[winget] Ignorando: $Id já está instalado" -Level Comment
    return $true
  }
  return $false
}

function Install-WingetPackage {
  param([string]$Id)

  Log "[winget] Instalando $Id..." -Level Command
  winget install --exact --id $Id --accept-package-agreements --accept-source-agreements --source winget
}

# ---- Invoke-WebRequest -------------------------------------------------------
function Test-WebRequestInstalled {
  param([string]$Name)

  if (Test-Command $Name) {
    Log "[iwr] Ignorando: $Name já está instalado" -Level Comment
    return $true
  }
  return $false
}

function Install-WebRequestPackage {
  param([string]$Name, [string]$Url, [string]$OutFile)

  Log "[iwr] Instalando $Name..." -Level Command
  Invoke-WebRequest $Url -OutFile $OutFile
  powershell -ExecutionPolicy Bypass -File $OutFile
  Remove-Item $OutFile -ErrorAction SilentlyContinue
}

# ---- pip ---------------------------------------------------------------------
function Test-PipInstalled {
  param([string]$Package)

  $pkg = pip show $Package 2>$null
  if ($pkg -match $Package) {
    Log "[pip] Ignorando: $Package já está instalado" -Level Comment
    return $true
  }
  return $false
}

function Install-PipPackage {
  param([string]$Package)

  Log "[pip] Instalando $Package..." -Level Command
  pip install --upgrade --upgrade-strategy eager $Package
}

# ---- pipx --------------------------------------------------------------------
function Test-PipxInstalled {
  param([string]$Package)

  if (pipx list 2>$null | Select-String $Package -Quiet) {
    Log "[pipx] Ignorando: $Package já está instalado" -Level Comment
    return $true
  }
  return $false
}

function Install-PipxPackage {
  param([string]$Package)

  Log "[pipx] Instalando $Package..." -Level Command
  pipx install $Package
}

# ---- vscode extensions -------------------------------------------------------
function Test-VSCodeExtensionInstalled {
  param([string]$Name, [string]$Id)

  $installed = code --list-extensions 2>$null
  if ($installed -contains $Id) {
    Log "[vscode] Ignorando: extensão $Name já instalada" -Level Comment
    return $true
  }
  return $false
}

function Install-VSCodeExtension {
  param([string]$Name, [string]$Id)

  Log "[vscode] Instalando extensão $Name..." -Level Command
  code --install-extension $Id --force
}

# ---- hooks -------------------------------------------------------------------
function Invoke-Hook {
  param([string]$Command)

  Log "[hook] Executando: $Command" -Level Command
  Invoke-Expression $Command
}

# ---- Utilitários gerais ------------------------------------------------------
function Test-Command {
  param([string]$Cmd)

  return (Get-Command $Cmd -ErrorAction SilentlyContinue)
}

# ==============================================================================
# Variáveis de ambiente (para instalação)
# ==============================================================================
$env:XDG_CONFIG_HOME = "{{ .env.xdg_config_home }}"
$env:XDG_BIN_HOME = "{{ .env.xdg_bin_home }}"
$env:XDG_DATA_HOME = "{{ .env.xdg_data_home }}"
$env:XDG_STATE_HOME = "{{ .env.xdg_state_home }}"

$env:PATH = "$env:XDG_BIN_HOME;$env:PATH"

# ==============================================================================
# Setup do sistema
# ==============================================================================

# Garante disponibilidade do winget
if (-not (Test-Command "winget")) {
  Log "[chezmoi] Habilitando winget..." -Level Task
  Add-AppxPackage -RegisterByFamilyName -MainPackage Microsoft.DesktopAppInstaller_8wekyb3d8bbwe
}

# Atualiza pacotes existentes
Log "`n[chezmoi] Atualizando pacotes via winget..." -Level Task
winget upgrade --all --accept-package-agreements --accept-source-agreements --source winget

{{- with .packages.windows }}

# ==============================================================================
# Instalação de pacotes (declarativa)
# ==============================================================================

{{- with .winget }}

# ---- winget ------------------------------------------------------------------
Log "`n[chezmoi] Instalando pacotes via winget..." -Level Task

{{- range . }}
if (-not (Test-WingetInstalled "{{ .name }}")) {
  Log "`n[winget] {{ .name }}..." -Level
  {{- with .pre_install }}
  {{- range . }}
  Invoke-Hook '{{ . }}'
  {{- end }}
  {{- end }}
  Install-WingetPackage "{{ .name }}"
  {{- with .post_install }}
  {{- range . }}
  Invoke-Hook '{{ . }}'
  {{- end }}
  {{- end }}
}
{{- end }}
{{- end }}

{{- with .invoke_web_request }}

# ---- Invoke-WebRequest -------------------------------------------------------
Log "`n[chezmoi] Instalando pacotes via Invoke-WebRequest..." -Level Task

{{- range . }}
if (-not (Test-WebRequestInstalled "{{ .name }}")) {
  Log "`n[iwr] {{ .name }}..." -Level
  {{- with .pre_install }}
  {{- range . }}
  Invoke-Hook '{{ . }}'
  {{- end }}
  {{- end }}
  Install-WebRequestPackage "{{ .name }}" "{{ .url }}" "{{ .out_file }}"
  {{- with .post_install }}
  {{- range . }}
  Invoke-Hook '{{ . }}'
  {{- end }}
  {{- end }}
}
{{- end }}
{{- end }}

{{- with .pip }}

# ---- pip ---------------------------------------------------------------------
Log "`n[chezmoi] Instalando pacotes pip..." -Level Task

{{- range . }}
if (-not (Test-PipInstalled "{{ .name }}")) {
  Log "`n[pip] {{ .name }}..." -Level
  {{- with .pre_install }}
  {{- range . }}
  Invoke-Hook '{{ . }}'
  {{- end }}
  {{- end }}
  Install-PipPackage "{{ .name }}"
  {{- with .post_install }}
  {{- range . }}
  Invoke-Hook '{{ . }}'
  {{- end }}
  {{- end }}
}
{{- end }}
{{- end }}

{{- with .pipx }}

# ---- pipx --------------------------------------------------------------------
Log "`n[chezmoi] Instalando pacotes pipx..." -Level Task

{{- range . }}
if (-not (Test-PipxInstalled "{{ .name }}")) {
  Log "`n[pipx] {{ .name }}..." -Level
  {{- with .pre_install }}
  {{- range . }}
  Invoke-Hook '{{ . }}'
  {{- end }}
  {{- end }}
  Install-PipxPackage "{{ .name }}"
  {{- with .post_install }}
  {{- range . }}
  Invoke-Hook '{{ . }}'
  {{- end }}
  {{- end }}
}
{{- end }}
{{- end }}

{{- with .vscode_extensions }}

# ---- vscode extensions -------------------------------------------------------
Log "`n[chezmoi] Instalando extensões do VSCode..." -Level Task

if (-not (Test-Command "code")) {
  Log "[vscode] Comando 'code' não encontrado. Ignorando instalação de extensões." -Level Warning
}
else {
{{- range . }}
  if (-not (Test-VSCodeExtensionInstalled "{{ .name }}" "{{ .id }}")) {
    {{- with .pre_install }}
    {{- range . }}
    Invoke-Hook '{{ . }}'
    {{- end }}
    {{- end }}
    Install-VSCodeExtension "{{ .name }}" "{{ .id }}"
    {{- with .post_install }}
    {{- range . }}
    Invoke-Hook '{{ . }}'
    {{- end }}
    {{- end }}
  }
{{- end }}
}
{{- end }}
{{- end }}

# ==============================================================================
# Finalização
# ==============================================================================
Log "`n[chezmoi] Instalação concluída com sucesso!" -Level Success

{{- end }}
