{{- if (or .system.is_linux .system.is_wsl) -}}
chezmoi:template:missing-key=invalid
#!/usr/bin/env bash

set -euo pipefail

# ---- source utils libraries -------------------------------------------------
UTILS_LIB="{{ joinPath .chezmoi.workingTree "scripts/linux/utils/bash_utils.sh" }}"
LOGGER_LIB="{{ joinPath .chezmoi.workingTree "scripts/linux/utils/logger.sh" }}"
for lib in "$UTILS_LIB" "$LOGGER_LIB"; do
  if [[ ! -f "$lib" ]]; then
    printf "\033[%sm%s\033[0m\n" "1;31" "❌ Required library not found: $lib" >&2
    exit 1
  fi
done
source "$UTILS_LIB"
source "$LOGGER_LIB"

# ==============================================================================
# Inicialização
# ==============================================================================
log "[chezmoi] Sistema operacional detectado: Linux" --level INFO
log "[chezmoi] Iniciando instalação declarativa..." --level TASK

{{- if .system.is_wsl }}

# ==============================================================================
# Validação de ambiente WSL
# ==============================================================================

# Evita conflitos causados por PATH herdado do Windows
if echo "$PATH" | tr ':' '\n' | grep -qi '^/mnt/[a-z]/'; then
  log "\n[chezmoi] Execução interrompida para evitar conflitos." --level ERROR
  log "[chezmoi] ⚠️ Detectado PATH do Windows no WSL."
  log "[chezmoi] Isso pode causar conflitos de ferramentas (ex: pyenv, node, etc)."
  log "[chezmoi] Recomenda-se desabilitar a herança do PATH do Windows:" --level COMMAND
  log "  1. Edite o arquivo /etc/wsl.conf (como root):"
  log "     [interop]"
  log "     appendWindowsPath=false"
  log "  2. Reinicie o WSL executando no Windows:"
  log "     wsl --shutdown"
  log "\n[chezmoi] Após isso, execute novamente o chezmoi."
  exit 1
fi
{{- end }}

# ==============================================================================
# Helpers
# ==============================================================================

# ---- apt ---------------------------------------------------------------------
verify_apt_package() {
  local name="$1"
  if dpkg -s "$name" &>/dev/null; then
    log "[apt] Ignorando: $name já está instalado." --level COMMENT
    return 0
  else
    return 1
  fi
}

install_apt_package() {
  local name="$1"
  log "[apt] Instalando $name..." --level COMMAND
  sudo apt install -y "$name"
}

# ---- curl --------------------------------------------------------------------
verify_curl_package() {
  local name="$1"
  if command -v "$name" &>/dev/null; then
    log "[curl] Ignorando: $name já está instalado." --level COMMENT
    return 0
  else
    return 1
  fi
}

install_curl_package() {
  local name="$1"
  local url="$2"
  local args="$3"
  log "[curl] Instalando $name..." --level COMMAND
  if [ -n "$args" ]; then
    curl -fsSL "$url" | bash -s -- $args
  else
    curl -fsSL "$url" | bash
  fi
}

# ---- pip ---------------------------------------------------------------------
verify_pip_package() {
  local name="$1"
  if pip show "$name" &>/dev/null; then
    log "[pip] Ignorando: $name já está instalado." --level COMMENT
    return 0
  else
    return 1
  fi
}

install_pip_package() {
  local name="$1"
  log "[pip] Instalando $name..." --level COMMAND
  pip install --upgrade --upgrade-strategy eager "$name"
}

# ---- pipx --------------------------------------------------------------------
verify_pipx_package() {
  local name="$1"
  if pipx list | grep -q "$name"; then
    log "[pipx] Ignorando: $name já está instalado." --level COMMENT
    return 0
  else
    return 1
  fi
}

install_pipx_package() {
  local name="$1"
  log "[pipx] Instalando $name..." --level COMMAND
  pipx install "$name"
}

# ---- hooks -------------------------------------------------------------------
run_hook_command() {
  local command="$1"
  log "[hook] Executando: $command" --level COMMAND
  eval "$command"
}

# ==============================================================================
# Variáveis de ambiente (para instalação)
# ==============================================================================
export XDG_CONFIG_HOME="{{ .env.xdg_config_home }}"
export XDG_BIN_HOME="{{ .env.xdg_bin_home }}"
export XDG_DATA_HOME="{{ .env.xdg_data_home }}"
export XDG_STATE_HOME="{{ .env.xdg_state_home }}"

# ==============================================================================
# Setup do sistema
# ==============================================================================

# Atualiza pacotes existentes
log "\n[apt] Atualizando pacotes já instalados..." --level TASK
sudo apt update && sudo apt upgrade -y

{{- with .packages.linux }}

# ==============================================================================
# Instalação de pacotes (declarativa)
# ==============================================================================

{{- with .apt }}

# ---- apt ---------------------------------------------------------------------
log "\n[chezmoi] Instalando pacotes via apt..." --level TASK
{{- range . }}
if ! verify_apt_package "{{ .name }}"; then
  {{- with .pre_install }}
  {{- range . }}
  run_hook_command '{{ . }}'
  {{- end }}
  {{- end }}
  install_apt_package "{{ .name }}"
  {{- with .post_install }}
  {{- range . }}
  run_hook_command '{{ . }}'
  {{- end }}
  {{- end }}
fi
{{- end }}
{{- end }}

{{- with .curl }}

# ---- curl --------------------------------------------------------------------
log "\n[chezmoi] Instalando pacotes via curl..." --level TASK
{{- range . }}
if ! verify_curl_package "{{ .name }}"; then
  {{- with .pre_install }}
  {{- range . }}
  run_hook_command '{{ . }}'
  {{- end }}
  {{- end }}
  install_curl_package "{{ .name }}" "{{ .url }}" "{{ .args }}"
  {{- with .post_install }}
  {{- range . }}
  run_hook_command '{{ . }}'
  {{- end }}
  {{- end }}
fi
{{- end }}
{{- end }}

{{- with .pip }}

# ---- pip ---------------------------------------------------------------------
log "\n[chezmoi] Instalando pacotes pip declarados..." --level TASK
{{- range . }}
if ! verify_pip_package "{{ .name }}"; then
  {{- with .pre_install }}
  {{- range . }}
  run_hook_command '{{ . }}'
  {{- end }}
  {{- end }}
  install_pip_package "{{ .name }}"
  {{- with .post_install }}
  {{- range . }}
  run_hook_command '{{ . }}'
  {{- end }}
  {{- end }}
fi
{{- end }}
{{- end }}

{{- with .pipx }}

# ---- pipx --------------------------------------------------------------------
log "\n[chezmoi] Instalando pacotes pipx declarados..." --level TASK
{{- range . }}
if ! verify_pipx_package "{{ .name }}"; then
  {{- with .pre_install }}
  {{- range . }}
  run_hook_command '{{ . }}'
  {{- end }}
  {{- end }}
  install_pipx_package "{{ .name }}"
  {{- with .post_install }}
  {{- range . }}
  run_hook_command '{{ . }}'
  {{- end }}
  {{- end }}
fi
{{- end }}
{{- end }}
{{- end }}

# ==============================================================================
# Finalização
# ==============================================================================
log "\n[chezmoi] Instalação concluída com sucesso!" --level SUCCESS
log "[chezmoi] Para aplicar as mudanças, recarregue seu shell ou execute: source ~/.bashrc" --level COMMAND

{{- end }}
