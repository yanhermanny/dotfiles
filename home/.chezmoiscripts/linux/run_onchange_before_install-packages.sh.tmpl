{{- if not (or .system.is_linux .system.is_wsl) -}}
chezmoi:template:missing-key=invalid
#!/usr/bin/env bash

set -e

# ==============================================================================
# Inicialização
# ==============================================================================
echo "[chezmoi] Sistema operacional detectado: Linux"
echo "[chezmoi] Iniciando instalação declarativa..."

{{- if .system.is_wsl }}

# ==============================================================================
# Validação de ambiente WSL
# ==============================================================================

# Evita conflitos causados por PATH herdado do Windows
if echo "$PATH" | tr ':' '\n' | grep -qi '^/mnt/[a-z]/'; then
  echo -e "\n[chezmoi] ❌ Execução interrompida para evitar conflitos."
  echo "[chezmoi] ⚠️ Detectado PATH do Windows no WSL."
  echo "[chezmoi] Isso pode causar conflitos de ferramentas (ex: pyenv, node, etc)."
  echo "[chezmoi] Recomenda-se desabilitar a herança do PATH do Windows:"
  echo "  1. Edite o arquivo /etc/wsl.conf (como root):"
  echo "     [interop]"
  echo "     appendWindowsPath=false"
  echo "  2. Reinicie o WSL executando no Windows:"
  echo "     wsl --shutdown"
  echo -e "\n[chezmoi] Após isso, execute novamente o chezmoi."
  exit 1
fi
{{- end }}

# ==============================================================================
# Helpers
# ==============================================================================

# ---- apt ---------------------------------------------------------------------
verify_apt_package() {
  local name="$1"
  if dpkg -s "$name" &>/dev/null; then
    echo "[apt] Ignorando: $name já está instalado."
    return 0
  else
    return 1
  fi
}

install_apt_package() {
  local name="$1"
  echo "[apt] Instalando $name..."
  $sudo apt install -y "$name"
}

# ---- curl --------------------------------------------------------------------
verify_curl_package() {
  local name="$1"
  if command -v "$name" &>/dev/null; then
    echo "[curl] Ignorando: $name já está instalado."
    return 0
  else
    return 1
  fi
}

install_curl_package() {
  local name="$1"
  local url="$2"
  local args="$3"
  echo "[curl] Instalando $name..."
  if [ -n "$args" ]; then
    curl -fsSL "$url" | bash -s -- $args
  else
    curl -fsSL "$url" | bash
  fi
}

# ---- pip ---------------------------------------------------------------------
verify_pip_package() {
  local name="$1"
  if pip show "$name" &>/dev/null; then
    echo "[pip] Ignorando: $name já está instalado."
    return 0
  else
    return 1
  fi
}

install_pip_package() {
  local name="$1"
  echo "[pip] Instalando $name..."
  pip install --upgrade --upgrade-strategy eager "$name"
}

# ---- pipx --------------------------------------------------------------------
verify_pipx_package() {
  local name="$1"
  if pipx list | grep -q "$name"; then
    echo "[pipx] Ignorando: $name já está instalado."
    return 0
  else
    return 1
  fi
}

install_pipx_package() {
  local name="$1"
  echo "[pipx] Instalando $name..."
  pipx install "$name"
}

# ---- hooks -------------------------------------------------------------------
run_hook_command() {
  local command="$1"
  echo "[hook] Executando: $command"
  eval "$command"
}

# ==============================================================================
# Variáveis de ambiente (para instalação)
# ==============================================================================
export XDG_CONFIG_HOME="{{ .env.xdg_config_home }}"
export XDG_BIN_HOME="{{ .env.xdg_bin_home }}"
export XDG_DATA_HOME="{{ .env.xdg_data_home }}"
export XDG_STATE_HOME="{{ .env.xdg_state_home }}"

# ==============================================================================
# Setup do sistema
# ==============================================================================

# Define privilégio de sudo (para root, não é necessário)
{{- if eq .chezmoi.username "root" }}
local sudo=""
{{- else }}
local sudo="sudo"
{{- end }}

# Atualiza pacotes existentes
echo -e "\n[apt] Atualizando pacotes já instalados..."
$sudo apt update && $sudo apt upgrade -y

{{- with .packages.linux }}

# ==============================================================================
# Instalação de pacotes (declarativa)
# ==============================================================================

{{- with .apt }}

# ---- apt ---------------------------------------------------------------------
echo -e "\n[chezmoi] Instalando pacotes via apt..."
{{- range . }}
if ! verify_apt_package "{{ .name }}"; then
  {{- with .pre_install }}
  {{- range . }}
  run_hook_command '{{ . }}'
  {{- end }}
  {{- end }}
  install_apt_package "{{ .name }}"
  {{- with .post_install }}
  {{- range . }}
  run_hook_command '{{ . }}'
  {{- end }}
  {{- end }}
fi
{{- end }}
{{- end }}

{{- with .curl }}

# ---- curl --------------------------------------------------------------------
echo -e "\n[chezmoi] Instalando pacotes via curl..."
{{- range . }}
if ! verify_curl_package "{{ .name }}"; then
  {{- with .pre_install }}
  {{- range . }}
  run_hook_command '{{ . }}'
  {{- end }}
  {{- end }}
  install_curl_package "{{ .name }}" "{{ .url }}" "{{ .args }}"
  {{- with .post_install }}
  {{- range . }}
  run_hook_command '{{ . }}'
  {{- end }}
  {{- end }}
fi
{{- end }}
{{- end }}

{{- with .pip }}

# ---- pip ---------------------------------------------------------------------
echo -e "\n[chezmoi] Instalando pacotes pip declarados..."
{{- range . }}
if ! verify_pip_package "{{ .name }}"; then
  {{- with .pre_install }}
  {{- range . }}
  run_hook_command '{{ . }}'
  {{- end }}
  {{- end }}
  install_pip_package "{{ .name }}"
  {{- with .post_install }}
  {{- range . }}
  run_hook_command '{{ . }}'
  {{- end }}
  {{- end }}
fi
{{- end }}
{{- end }}

{{- with .pipx }}

# ---- pipx --------------------------------------------------------------------
echo -e "\n[chezmoi] Instalando pacotes pipx declarados..."
{{- range . }}
if ! verify_pipx_package "{{ .name }}"; then
  {{- with .pre_install }}
  {{- range . }}
  run_hook_command '{{ . }}'
  {{- end }}
  {{- end }}
  install_pipx_package "{{ .name }}"
  {{- with .post_install }}
  {{- range . }}
  run_hook_command '{{ . }}'
  {{- end }}
  {{- end }}
fi
{{- end }}
{{- end }}
{{- end }}

# ==============================================================================
# Finalização
# ==============================================================================
echo -e "\n[chezmoi] Instalação concluída com sucesso!"
echo "[chezmoi] Para aplicar as mudanças, recarregue seu shell ou execute: source ~/.bashrc"

{{- end }}
