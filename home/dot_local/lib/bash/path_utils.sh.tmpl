#!/usr/bin/env bash
# ~/.local/lib/bash/path_utils.sh
# --------------------------------------------------------------------------------
# Path utilities
# --------------------------------------------------------------------------------

# ---- normaliza caminho (remove barras finais redundantes) --------------------
_normalize_path() {
  local p="$1"

  [[ -z "$p" ]] && return 1
  while [[ "$p" == */ && "$p" != "/" ]]; do
    p="${p%/}"
  done
  printf '%s\n' "$p"
}

{{- if .system.is_windows }}

# ---- converte caminhos do Windows para formato Unix --------------------------
win_to_unix_path() {
  local p="$1"

  [[ -z "$p" ]] && return 1
  case "$p" in
    [A-Za-z]:*|\\*)
      p="$(cygpath -u "$p")"
      ;;
  esac
  _normalize_path "$p"
}
{{- end }}

# ---- remove caminho do PATH (se existir) -------------------------------------
remove_from_path() {
  local dir="$1"

  [[ -n "$dir" && -n "$PATH" ]] || return 0

  {{- if .system.is_windows }}
  dir="$(win_to_unix_path "$dir")" || return 1
  {{- else }}
  dir="$(_normalize_path "$dir")" || return 1
  {{- end }}
  [[ ":$PATH:" == *":$dir:"* ]] || return 0

  local IFS=':'
  local -a parts=($PATH)
  local -a kept=()
  local p

  for p in "${parts[@]}"; do
    [[ -z "$p" ]] && continue
    [[ "$p" == "$dir" ]] && continue
    kept+=("$p")
  done

  PATH=''
  for p in "${kept[@]}"; do
    PATH="${PATH:+$PATH:}$p"
  done

  export PATH
}

# ---- adiciona caminho ao PATH (normalizando e evitando duplicados) -----------
add_to_path() {
  local dir="$1"

  [[ -n "$dir" ]] || return 0

  {{- if .system.is_windows }}
  dir="$(win_to_unix_path "$dir")" || return 1
  {{- else }}
  dir="$(_normalize_path "$dir")" || return 1
  {{- end }}
  [[ -d "$dir" ]] || return 0
  remove_from_path "$dir"

  export PATH="$dir${PATH:+:$PATH}"
}
