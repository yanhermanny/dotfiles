#!/usr/bin/env sh
# ~/.config/bash/01_environment.sh
# --------------------------------------------------------------------------------
# Configurações do ambiente do shell
# --------------------------------------------------------------------------------

# ==============================================================================
# XDG Base Directories
# ==============================================================================

{{- if .system.is_windows }}
export XDG_CONFIG_HOME="$(win_to_unix_path "${XDG_CONFIG_HOME:-{{ .env.xdg_config_home }}}")"
export XDG_BIN_HOME="$(win_to_unix_path "${XDG_BIN_HOME:-{{ .env.xdg_bin_home }}}")"
export XDG_LIB_HOME="$(win_to_unix_path "${XDG_LIB_HOME:-{{ .env.xdg_lib_home }}}")"
export XDG_DATA_HOME="$(win_to_unix_path "${XDG_DATA_HOME:-{{ .env.xdg_data_home }}}")"
export XDG_STATE_HOME="$(win_to_unix_path "${XDG_STATE_HOME:-{{ .env.xdg_state_home }}}")"
{{- else }}
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-{{ .env.xdg_config_home }}}"
export XDG_BIN_HOME="${XDG_BIN_HOME:-{{ .env.xdg_bin_home }}}"
export XDG_LIB_HOME="${XDG_LIB_HOME:-{{ .env.xdg_lib_home }}}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-{{ .env.xdg_data_home }}}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-{{ .env.xdg_state_home }}}"
{{- end }}

# Garante existência dos diretórios
mkdir -p "$XDG_CONFIG_HOME" "$XDG_BIN_HOME" "$XDG_LIB_HOME" "$XDG_DATA_HOME" "$XDG_STATE_HOME"

# ==============================================================================
# Source PATH utilities library
# ==============================================================================
PATH_UTILS_LIB="$XDG_LIB_HOME/bash/path_utils.sh"
if [[ -f "$PATH_UTILS_LIB" ]]; then
  source "$PATH_UTILS_LIB"
else
  echo "❌ PATH utilities library not found: $PATH_UTILS_LIB"
  exit 1
fi

# ---- adiciona binários do usuário no PATH ------------------------------------
add_to_path "$XDG_BIN_HOME"

# ==============================================================================
# Variáveis gerais de ambiente
# ==============================================================================
export EDITOR='nano'
export LS_OPTIONS='--color=auto'

# ---- less (pager padrão) -----------------------------------------------------
# -R   : renderiza cores corretamente
# -M   : prompt detalhado
# -N   : números de linha
# -S   : corta linhas longas (sem wrap)
# -~   : remove ~ após EOF
# -#3  : scroll horizontal de 3 colunas
# -i   : busca case-insensitive (condicional)
# -+F  : força modo interativo
# -+X  : usa alternate screen
export LESS='-RMnS~#3i -+F -+X'
export LESSCHARSET='utf-8'
export LESSHISTFILE=-

{{- if .system.is_windows }}

# ==============================================================================
# Ajustes específicos do Windows (MSYS / Git Bash)
# ==============================================================================

# Habilita links simbólicos nativos no MSYS2 (Git Bash)
export MSYS="winsymlinks:native"

# Usa OpenSSH nativo do Windows
add_to_path "/c/Windows/System32/OpenSSH"
{{- end }}

# ==============================================================================
# Ferramentas de desenvolvimento
# ==============================================================================

# ---- fnm (Node.js) -----------------------------------------------------------
if command -v fnm > /dev/null 2>&1; then
  {{- if .system.is_windows }}
  export FNM_DIR="$XDG_DATA_HOME/fnm"
  {{- end }}
  eval "$(fnm env --use-on-cd --shell bash)"
fi

# ---- pyenv -------------------------------------------------------------------
{{- if .system.is_windows }}
export PYENV_ROOT="$(win_to_unix_path "${PYENV_ROOT:-$XDG_DATA_HOME/pyenv/pyenv-win}")"
export PYENV="$PYENV_ROOT"
export PYENV_HOME="$PYENV_ROOT"

[[ -d $PYENV_ROOT/bin ]] && add_to_path "$PYENV_ROOT/bin"
[[ -d $PYENV_ROOT/shims ]] && add_to_path "$PYENV_ROOT/shims"
{{- else }}
export PYENV_ROOT="$XDG_DATA_HOME/pyenv"
[[ -d $PYENV_ROOT/bin ]] && add_to_path "$PYENV_ROOT/bin"
eval "$(pyenv init - bash)"
{{- end }}

# ---- pipx --------------------------------------------------------------------
{{- if .system.is_windows }}
export PIPX_HOME="$(win_to_unix_path "${PIPX_HOME:-$XDG_DATA_HOME/pipx}")"
export PIPX_BIN_DIR="$(win_to_unix_path "${PIPX_BIN_DIR:-$XDG_BIN_HOME}")"
{{- else }}
export PIPX_HOME="$XDG_DATA_HOME/pipx"
export PIPX_BIN_DIR="$XDG_BIN_HOME"
{{- end }}

# ---- bat ---------------------------------------------------------------------
{{- if .system.is_windows }}
export BAT_CONFIG_DIR="$(win_to_unix_path "${BAT_CONFIG_DIR:-$XDG_CONFIG_HOME/bat}")"
{{- else }}
export BAT_CONFIG_DIR="$XDG_CONFIG_HOME/bat"
{{- end }}

# ==============================================================================
# Limpeza
# ==============================================================================
unset -v PATH_UTILS_LIB
