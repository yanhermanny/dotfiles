#!/usr/bin/env sh
# ~/.config/bash/03_aliases.sh
# --------------------------------------------------------------------------------
# Aliases
# --------------------------------------------------------------------------------

# ==============================================================================
# ls (listagem de arquivos)
# ==============================================================================

# Opções utilizadas:
# -1 : uma entrada por linha
# -h : tamanhos legíveis (1K, 234M, 2G)
# -F : sufixos de tipo (*, /, etc)
# -A : inclui arquivos ocultos (exceto . e ..)
# -l : formato detalhado

{{- if .system.is_windows }}

# Exclusões específicas do Windows
LS_EXCLUSIONS="-I desktop.ini"
LS_EXCLUSIONS="$LS_EXCLUSIONS -I My\ Documents\*"
LS_EXCLUSIONS="$LS_EXCLUSIONS -I NTUSER\*"
LS_EXCLUSIONS="$LS_EXCLUSIONS -I ntuser\*"

alias ls="command ls -F --color=auto $LS_EXCLUSIONS"
{{- else }}
alias ls="command ls -F --color=auto"
{{- end }}
alias la="ls -A"
alias ll="ls -lhA"

# ==============================================================================
# Busca (grep)
# ==============================================================================

# Ativa cores automaticamente
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

# ==============================================================================
# Navegação de diretórios
# ==============================================================================

# Ir para root sem espaço (cd/)
cd/() {
  cd /
}

# Subir diretório rapidamente
alias cd..='cd ../'
alias ..='cd ../'

# ==============================================================================
# Substituições de comandos
# ==============================================================================

# Usa bat no lugar de cat (sem pager)
alias cat='bat --paging=never'

# Usa delta no lugar de diff
alias diff="delta"

{{- if .system.is_windows }}

# ==============================================================================
# Ajustes específicos do Windows
# ==============================================================================

# tree (versão nativa do Windows)
alias tree="tree.com //A"

# Abrir diretório no Explorer
explorer() {
  command explorer "$(cygpath -w "$@")"
}
{{- end }}
