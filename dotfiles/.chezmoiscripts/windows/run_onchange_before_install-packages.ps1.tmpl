{{- if .system.is_windows -}}
Write-Host "[chezmoi] Sistema operacional detectado: Windows" -ForegroundColor Cyan
Write-Host "[chezmoi] Iniciando instalação declarativa..." -ForegroundColor Cyan

# -------------------------------------------------------------------------------------
# Helper: verifica se pacote winget já está instalado
# -------------------------------------------------------------------------------------
function Test-WingetInstalled {
  param([string]$Id)

  $pkg = winget list --exact --id $Id --source winget 2>$null
  return ($pkg -match $Id)
}

# -------------------------------------------------------------------------------------
# Helper: instala pacote via winget
# -------------------------------------------------------------------------------------
function Install-WingetPackage {
  param([string]$Id)

  if (Test-WingetInstalled $Id) {
    Write-Host "[winget] Ignorando: $Id já está instalado" -ForegroundColor DarkGray
    return
  }

  Write-Host "[winget] Instalando $Id..." -ForegroundColor Yellow
  winget install --exact --id $Id --accept-package-agreements --accept-source-agreements --source winget

  if ($LASTEXITCODE -ne 0) {
    Write-Host "[ERROR] winget falhou ao instalar $Id (exit code $LASTEXITCODE)" -ForegroundColor Red
  }
}

# -------------------------------------------------------------------------------------
# Helper: verifica se pacote pip já está instalado
# -------------------------------------------------------------------------------------
function Test-PipInstalled {
  param([string]$Package)

  $pkg = & $script:PyManager exec -m pip show $Package 2>$null
  return ($pkg -match $Package)
}

# -------------------------------------------------------------------------------------
# Helper: instala pacote pip
# -------------------------------------------------------------------------------------
function Install-PipPackage {
  param([string]$Package)

  if (-not $script:PyManager) {
    Write-Host "[pip] PyManager indisponível. Pacote não instalado: $Package" -ForegroundColor Red
    return
  }
  if (Test-PipInstalled $Package) {
    Write-Host "[pip] Ignorando: $Package já está instalado" -ForegroundColor DarkGray
    return
  }

  Write-Host "[pip] Instalando $Package..." -ForegroundColor Yellow
  & $script:PyManager exec -m pip install --upgrade --upgrade-strategy eager $Package
}

# =====================================================================================
# 1) Habilitar winget
# =====================================================================================
if (-not (Get-Command winget -ErrorAction SilentlyContinue)) {
  Write-Host "[chezmoi] Habilitando winget..." -ForegroundColor Cyan
  Add-AppxPackage -RegisterByFamilyName -MainPackage Microsoft.DesktopAppInstaller_8wekyb3d8bbwe
}

# =====================================================================================
# 2) Instalar pacotes winget
# =====================================================================================
Write-Host "`n[chezmoi] Instalando pacotes via winget..." -ForegroundColor Green
{{ range .packages.winget }}
Install-WingetPackage "{{ . }}"
{{- end }}

# =====================================================================================
# 3) Instalar Python mais recente via Python Install Manager (PIM)
# =====================================================================================
Write-Host "`n[chezmoi] Verificando se Python Install Manager (pymanager) está instalado..." -ForegroundColor Green
$PyManager = "pymanager"
if (-not (Get-Command $PyManager -ErrorAction SilentlyContinue)) {
  Write-Host "[chezmoi] Python Install Manager não encontrado via PATH. Buscando no local de instalação..." -ForegroundColor Yellow
  $PyManager = Join-Path $env:ProgramFiles "PyManager\pymanager.exe"

  if (-not (Test-Path $PyManager)) {
    Write-Host "[ERROR] Python Install Manager não encontrado em $PyManager. Pulando instalação do Python e pacotes pip" -ForegroundColor Red
    $PyManager = $null
  }
}

if ($PyManager) {
  Write-Host "[chezmoi] Comando PyManager definido: $PyManager" -ForegroundColor Cyan
  $PythonInstalled = & $PyManager list | Select-String "Python" -Quiet
  if ($PythonInstalled) {
    Write-Host "[chezmoi] Ignorando: Python já está instalado" -ForegroundColor DarkGray
  } else {
    Write-Host "`n[chezmoi] Instalando Python mais recente via Python Install Manager..." -ForegroundColor Green
    & $PyManager install default --update
  }

  # =====================================================================================
  # 3.1) Instalar pacotes pip declarados
  # =====================================================================================
  Write-Host "`n[chezmoi] Instalando pacotes pip declarados..." -ForegroundColor Green
  {{ range .packages.pip }}
  Install-PipPackage "{{ . }}"
  {{- end }}
}

# =====================================================================================
# 4) Instalar Node LTS via fnm
# =====================================================================================
Write-Host "`n[chezmoi] Verificando se fnm está instalado..." -ForegroundColor Green
$FNM = "fnm"
if (-not (Get-Command $FNM -ErrorAction SilentlyContinue)) {
  Write-Host "[chezmoi] fnm não encontrado via PATH. Buscando no local de instalação..." -ForegroundColor Yellow
  $FNM = Join-Path $env:LocalAppData "Microsoft\WinGet\Links\fnm.exe"

  if (-not (Test-Path $FNM)) {
    Write-Host "[ERROR] fnm não encontrado em $FNM. Pulando instalação do Node LTS" -ForegroundColor Red
    $FNM = $null
  }
}

if ($FNM) {
  Write-Host "[chezmoi] Comando fnm definido: $FNM" -ForegroundColor Cyan
  $NodeInstalled = & $FNM list | Select-String "default" -Quiet
  if ($NodeInstalled) {
    Write-Host "[chezmoi] Ignorando: Node já está instalado" -ForegroundColor DarkGray
  } else {
    Write-Host "`n[chezmoi] Instalando Node LTS via fnm..." -ForegroundColor Green
    & $FNM install --lts
    & $FNM default lts-latest
  }
}

Write-Host "`n[chezmoi] Instalação concluída com sucesso!" -ForegroundColor Cyan
{{- end }}
