{{- range . }}
if (-not (Test-PipInstalled "{{ .name }}")) {
  {{- with .pre_install }}
  {{- range . }}
  Invoke-Hook '{{ . }}'
  {{- end }}
  {{- end }}
  Install-PipPackage "{{ .name }}"
  {{- with .post_install }}
  {{- range . }}
  Invoke-Hook '{{ . }}'
  {{- end }}
  {{- end }}
}
{{- end }}
# -------------------------------------------------------------------------------------
{{- end }}

