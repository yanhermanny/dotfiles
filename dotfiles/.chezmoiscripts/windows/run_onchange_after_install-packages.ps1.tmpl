{{- if .system.is_windows -}}
chezmoi:template:missing-key=invalid
Write-Host "[chezmoi] Sistema operacional detectado: Windows" -ForegroundColor Cyan
Write-Host "[chezmoi] Iniciando instalação declarativa..." -ForegroundColor Cyan

# -------------------------------------------------------------------------------------
# Helper: executa comandos (hooks)
function Invoke-Hook {
  param([string]$Command)

  Write-Host "[hook] Executando: $Command" -ForegroundColor DarkGray
  Invoke-Expression $Command
}
# -------------------------------------------------------------------------------------

# -------------------------------------------------------------------------------------
# Helper: verifica se pacote winget já está instalado
function Test-WingetInstalled {
  param([string]$Id)

  $pkg = winget list --exact --id $Id --source winget 2>$null
  if ($pkg -match $Id) {
    Write-Host "[winget] Ignorando: $Id já está instalado" -ForegroundColor DarkGray
    return $true
  }
  return $false
}
# -------------------------------------------------------------------------------------

# -------------------------------------------------------------------------------------
# Helper: instala pacote via winget
function Install-WingetPackage {
  param([string]$Id)

  Write-Host "[winget] Instalando $Id..." -ForegroundColor Yellow
  winget install --exact --id $Id --accept-package-agreements --accept-source-agreements --source winget
}
# -------------------------------------------------------------------------------------

# -------------------------------------------------------------------------------------
# Helper: verifica se pacote Invoke-WebRequest já está instalado
function Test-WebRequestInstalled {
  param([string]$Name)

  if (Test-Command $Name) {
    Write-Host "[iwr] Ignorando: $Name já está instalado" -ForegroundColor DarkGray
    return $true
  }
  return $false
}
# -------------------------------------------------------------------------------------

# -------------------------------------------------------------------------------------
# Helper: instala pacote via Invoke-WebRequest
function Install-WebRequestPackage {
  param([string]$Name, [string]$Url, [string]$OutFile)

  Write-Host "[iwr] Instalando $Name..." -ForegroundColor Yellow
  Invoke-WebRequest $Url -OutFile $OutFile
  powershell -ExecutionPolicy Bypass -File $OutFile
  Remove-Item $OutFile -ErrorAction SilentlyContinue
}
# -------------------------------------------------------------------------------------

# -------------------------------------------------------------------------------------
# Helper: verifica se pacote pip já está instalado
function Test-PipInstalled {
  param([string]$Package)

  $pkg = pip show $Package 2>$null
  if ($pkg -match $Package) {
    Write-Host "[pip] Ignorando: $Package já está instalado" -ForegroundColor DarkGray
    return $true
  }
  return $false
}
# -------------------------------------------------------------------------------------

# -------------------------------------------------------------------------------------
# Helper: instala pacote pip
function Install-PipPackage {
  param([string]$Package)

  Write-Host "[pip] Instalando $Package..." -ForegroundColor Yellow
  pip install --upgrade --upgrade-strategy eager $Package
}
# -------------------------------------------------------------------------------------

# -------------------------------------------------------------------------------------
# Helper: verifica se pacote pipx já está instalado
function Test-PipxInstalled {
  param([string]$Package)

  if (pipx list 2>$null | Select-String $Package -Quiet) {
    Write-Host "[pipx] Ignorando: $Package já está instalado" -ForegroundColor DarkGray
    return $true
  }
  return $false
}
# -------------------------------------------------------------------------------------

# -------------------------------------------------------------------------------------
# Helper: instala pacote pipx
function Install-PipxPackage {
  param([string]$Package)

  Write-Host "[pipx] Instalando $Package..." -ForegroundColor Yellow
  pipx install $Package
}
# -------------------------------------------------------------------------------------

# -------------------------------------------------------------------------------------
# Helper: verifica comando disponível
function Test-Command {
  param([string]$Cmd)

  return (Get-Command $Cmd -ErrorAction SilentlyContinue)
}
# -------------------------------------------------------------------------------------

# =====================================================================================
# Habilitar winget
# =====================================================================================
if (-not (Test-Command "winget")) {
  Write-Host "[chezmoi] Habilitando winget..." -ForegroundColor Cyan
  Add-AppxPackage -RegisterByFamilyName -MainPackage Microsoft.DesktopAppInstaller_8wekyb3d8bbwe
}
# -------------------------------------------------------------------------------------

Write-Host "`n[chezmoi] Atualizando pacotes via winget..." -ForegroundColor Green
winget upgrade --all --accept-package-agreements --accept-source-agreements --source winget

{{ with .packages.windows -}}
{{ with .winget -}}
# =====================================================================================
# Instalar pacotes via winget
# =====================================================================================
Write-Host "`n[chezmoi] Instalando pacotes via winget..." -ForegroundColor Green

{{- range . }}
if (-not (Test-WingetInstalled "{{ .name }}")) {
  {{- with .pre_install }}
  {{- range . }}
  Invoke-Hook '{{ . }}'
  {{- end }}
  {{- end }}
  Install-WingetPackage "{{ .name }}"
  {{- with .post_install }}
  {{- range . }}
  Invoke-Hook '{{ . }}'
  {{- end }}
  {{- end }}
}
{{- end }}
# -------------------------------------------------------------------------------------
{{- end }}

{{ with .invoke_web_request -}}
# =====================================================================================
# Instalar via Invoke-WebRequest
# =====================================================================================
Write-Host "`n[chezmoi] Instalando pacotes via Invoke-WebRequest..." -ForegroundColor Green
{{- range . }}
if (-not (Test-WebRequestInstalled "{{ .name }}")) {
  {{- with .pre_install }}
  {{- range . }}
  Invoke-Hook '{{ . }}'
  {{- end }}
  {{- end }}
  Write-Host "[iwr] Instalando {{ .name }}..." -ForegroundColor Yellow
  Install-WebRequestPackage "{{ .name }}" "{{ .url }}" "{{ .out_file }}"
  {{- with .post_install }}
  {{- range . }}
  Invoke-Hook '{{ . }}'
  {{- end }}
  {{- end }}
}
{{- end }}
# -------------------------------------------------------------------------------------
{{- end }}

