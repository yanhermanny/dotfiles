{{- range . }}
if (-not (Test-PipxInstalled "{{ .name }}")) {
  {{- with .pre_install }}
  {{- range . }}
  Invoke-Hook '{{ . }}'
  {{- end }}
  {{- end }}
  Install-PipxPackage "{{ .name }}"
  {{- with .post_install }}
  {{- range . }}
  Invoke-Hook '{{ . }}'
  {{- end }}
  {{- end }}
}
{{- end }}
# -------------------------------------------------------------------------------------
{{- end }}
{{- end }}
Write-Host "`n[chezmoi] Instalação concluída com sucesso!" -ForegroundColor Cyan
{{- end }}
