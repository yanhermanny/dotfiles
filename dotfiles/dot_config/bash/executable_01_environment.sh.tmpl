#!/usr/bin/env sh
# ~/.config/bash/01_environment.sh
# --------------------------------------------------------------------------------
# Configurações do ambiente de shell
# --------------------------------------------------------------------------------

{{- if .system.is_windows }}

# -------------------------------------------------------------------------------------
# Helper: converte caminho do Windows para Unix
_win_to_unix_path() {
  local input="$1"

  local expanded="$input"
  while [[ "$expanded" =~ %([^%]+)% ]]; do
    local var="${BASH_REMATCH[1]}"
    local value="${!var}"

    if [[ -z "$value" ]]; then
      value="$(cmd.exe /C "echo %$var%" 2>/dev/null | tr -d '\r')"
    fi

    expanded="${expanded//%$var%/$value}"
  done

  if [[ "$expanded" =~ ^[a-zA-Z]:[\\/]|^\\\\ ]]; then
    local path="${expanded//\\//}"

    if [[ "$path" =~ ^([a-zA-Z]):/(.*) ]]; then
      local drive="${BASH_REMATCH[1],,}"  # lowercase
      local rest="${BASH_REMATCH[2]}"
      echo "/$drive/$rest"
      return
    fi

    if [[ "$path" =~ ^//([^/]+)/(.*) ]]; then
      local server="${BASH_REMATCH[1]}"
      local rest="${BASH_REMATCH[2]}"
      echo "/unc/$server/$rest"
      return
    fi

    echo "$path"
    return
  fi

  echo "$input"
}
# -------------------------------------------------------------------------------------

# -------------------------------------------------------------------------------------
# Helper: adiciona caminho ao PATH
_add_to_path() {
  local input="$1"
  local new
  new="$(_win_to_unix_path "$input")"

  new="$(realpath -m "$new" 2>/dev/null || echo "$new")"

  local IFS=':'
  local -a parts=($PATH)
  local -a filtered=()

  for p in "${parts[@]}"; do
    [[ -z "$p" ]] && continue

    local p_unix
    p_unix="$(_win_to_unix_path "$p")"

    local resolved
    resolved="$(realpath -m "$p_unix" 2>/dev/null || echo "$p_unix")"

    if [[ "$resolved" != "$new" ]]; then
      filtered+=("$p_unix")
    fi
  done

  PATH="$new"
  for p in "${filtered[@]}"; do
    PATH="$PATH:$p"
  done

  export PATH
}
# -------------------------------------------------------------------------------------
{{- else }}

# -------------------------------------------------------------------------------------
# Helper: adiciona caminho ao PATH
_add_to_path() {
  local dir="$1"
  if [[ -d "$dir" && ":$PATH:" != *":$dir:"* ]]; then
    export PATH="$dir:$PATH"
  fi
}
# -------------------------------------------------------------------------------------
{{- end }}

# Adiciona o diretório de binários do usuário ao PATH
_add_to_path "$XDG_BIN_HOME"

# Define o editor padrão
export EDITOR='nano'

# Opções do ls para cores automáticas
export LS_OPTIONS='--color=auto'

{{- if .system.is_windows }}

# Habilita links simbólicos nativos no MSYS2 (Git Bash)
export MSYS="winsymlinks:native"

# Adiciona o OpenSSH do Windows ao PATH para usar ssh/ssh-agent nativos
_add_to_path "/c/Windows/System32/OpenSSH"
{{- end }}

# Enables Fast Node Manager (fnm)
if command -v fnm > /dev/null 2>&1; then
  {{ if not .system.is_windows -}}
  export FNM_DIR="$XDG_DATA_HOME/fnm"
  {{ end -}}
  eval "$(fnm env --use-on-cd --shell bash)"
fi

# Setup `pyenv` for Python version management
{{- if .system.is_windows }}
export PYENV_ROOT="$(_win_to_unix_path "${PYENV_ROOT:-$XDG_DATA_HOME/pyenv/pyenv-win}")"
export PYENV="$PYENV_ROOT"
export PYENV_HOME="$PYENV_ROOT"
[[ -d $PYENV_ROOT/bin ]] && _add_to_path "$PYENV_ROOT/bin"
[[ -d $PYENV_ROOT/shims ]] && _add_to_path "$PYENV_ROOT/shims"
{{- else }}
export PYENV_ROOT="$XDG_DATA_HOME/pyenv"
[[ -d $PYENV_ROOT/bin ]] && _add_to_path "$PYENV_ROOT/bin"
eval "$(pyenv init - bash)"
{{- end }}

# Define variáveis para o `pipx`
{{- if .system.is_windows }}
export PIPX_HOME="$(_win_to_unix_path "${PIPX_HOME:-$XDG_DATA_HOME/pipx}")"
export PIPX_BIN_DIR="$(_win_to_unix_path "${PIPX_BIN_DIR:-$XDG_BIN_HOME}")"
{{- else }}
export PIPX_HOME="$XDG_DATA_HOME/pipx"
export PIPX_BIN_DIR="$XDG_BIN_HOME"
{{- end }}

# Define local para configurações do `bat`
{{- if .system.is_windows }}
export BAT_CONFIG_DIR="$(_win_to_unix_path "${BAT_CONFIG_DIR:-$XDG_CONFIG_HOME/bat}")"
{{- else }}
export BAT_CONFIG_DIR="$XDG_CONFIG_HOME/bat"
{{- end }}

# Define o comportamento do comando less
## -R: melhor exibição de caracteres de controle
## -M: prompt longo, com nome do arquivo e informações da quantidade de linhas
## -N: ativa números de linha
## -S: ativa o 'chop-long-lines', ou seja, trunca linhas maiores que a tela (desativa o line wrap)
## -~: desativa a exibição de '~' nas linhas após o fim do arquivo
## -#3: configura o scroll horizontal para 3 posições por vez
## -i: pesquisa case insensitive, a menos que haja letras maiúsculas na busca
## -+F: desativa o 'quit-if-one-screen', ou seja, sempre entra no modo interativo, mesmo para saídas curtas
## -+X: desativa o 'no-init', ou seja, sempre utiliza o alternate screen, limpando a tela ao sair
## Utilizar cores
### -DNk: números de linha pretos
### -DPc: prompt cyano
### -DRc: rscroll character cyano
export LESS='-RMnS~#3i -+F -+X'

# Define o charset utilizado
export LESSCHARSET='utf-8'

# Desabilita o histórico do less
export LESSHISTFILE=-

{{ if .system.is_windows -}}
unset -f _win_to_unix_path
{{- end }}
unset -f _add_to_path
